{application, agora_provider_router,
 [{description, "agora provider-router — Erlang/OTP re-implementation (agora:80, ADR-0004)"},
  {vsn, "0.1.0"},
  {registered, [agora_provider_router_sup, apr_ladder_sup,
                apr_assets, apr_subscriber_sup, apr_bus, apr_translate]},
  {mod, {agora_provider_router_app, []}},
  {applications,
   [kernel,
    stdlib,
    crypto,
    cowboy]},
  {env, [{port, 8080}]},
  {modules, []},
  {licenses, ["Apache-2.0"]}
 ]}.
