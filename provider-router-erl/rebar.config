%% agora provider-router — Erlang/OTP re-implementation (agora:80, ADR-0004).
%% The gate is `make check-router-erl`: rebar3 compile + dialyzer + eunit + ct.
{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [{cowboy, "2.12.0"}]}.

%% Dialyzer PLT: build the local + OTP app PLT once, then typecheck the app against it.
{dialyzer, [
    {warnings, [unmatched_returns, error_handling, no_improper_lists]},
    {plt_apps, all_deps},
    {plt_extra_apps, [inets, ssl]}
]}.

%% eunit lives next to the src as *_tests.erl; ct suites live under test/ as *_SUITE.erl.
{eunit_opts, [verbose]}.
{ct_opts, [{dir, "test"}]}.

{profiles, [
    {test, [
        {erl_opts, [debug_info, nowarn_export_all]}
    ]}
]}.

{shell, [{apps, [agora_provider_router]}]}.
