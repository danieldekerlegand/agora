{
  "kcb_version": "0.4.3",
  "identity": "agora:agent:provider-router",
  "version": "0.1.0",
  "endpoints": {
    "openai": "http://127.0.0.1:8000/v1",
    "mcp": "http://127.0.0.1:8000/mcp",
    "a2a": "http://127.0.0.1:8000/a2a",
    "doctor": "http://127.0.0.1:8000/doctor",
    "manifest": "http://127.0.0.1:8000/.well-known/agent-card.json"
  },
  "produces": [
    {
      "plane": "knowledge",
      "shape": "completion-text"
    },
    {
      "plane": "media",
      "media_types": [
        "image/png"
      ],
      "world_pattern": "*"
    },
    {
      "plane": "media",
      "media_types": [
        "audio/wav"
      ],
      "world_pattern": "*"
    },
    {
      "plane": "media",
      "media_types": [
        "video/mp4"
      ],
      "world_pattern": "*"
    }
  ],
  "consumes": [
    {
      "plane": "knowledge",
      "shape": "chat-messages"
    },
    {
      "plane": "knowledge",
      "shape": "prompt-text"
    }
  ],
  "capabilities": [
    {
      "name": "generate.text",
      "inputs": [
        {
          "plane": "knowledge",
          "shape": "chat-messages"
        }
      ],
      "outputs": [
        {
          "plane": "knowledge",
          "shape": "completion-text"
        }
      ],
      "cost": {
        "tier": "placeholder",
        "est_units": 0.0,
        "unit": "token",
        "quantity": 1000.0,
        "basis": "1000 completion tokens",
        "unpriced": false
      },
      "endpoint": "http://127.0.0.1:8000/v1/chat/completions",
      "provider": "placeholder",
      "model": "placeholder-text"
    },
    {
      "name": "generate.image",
      "inputs": [
        {
          "plane": "knowledge",
          "shape": "prompt-text"
        }
      ],
      "outputs": [
        {
          "plane": "media",
          "media_types": [
            "image/png"
          ],
          "world_pattern": "*"
        }
      ],
      "cost": {
        "tier": "placeholder",
        "est_units": 0.0,
        "unit": "image",
        "quantity": 1.0,
        "basis": "one image",
        "unpriced": false
      },
      "endpoint": "http://127.0.0.1:8000/v1/images/generations",
      "provider": "placeholder",
      "model": "placeholder-image"
    },
    {
      "name": "generate.speech",
      "inputs": [
        {
          "plane": "knowledge",
          "shape": "prompt-text"
        }
      ],
      "outputs": [
        {
          "plane": "media",
          "media_types": [
            "audio/wav"
          ],
          "world_pattern": "*"
        }
      ],
      "cost": {
        "tier": "placeholder",
        "est_units": 0.0,
        "unit": "character",
        "quantity": 1000.0,
        "basis": "1000 characters of narration",
        "unpriced": false
      },
      "endpoint": "http://127.0.0.1:8000/v1/audio/speech",
      "provider": "placeholder",
      "model": "placeholder-speech"
    },
    {
      "name": "generate.music",
      "inputs": [
        {
          "plane": "knowledge",
          "shape": "prompt-text"
        }
      ],
      "outputs": [
        {
          "plane": "media",
          "media_types": [
            "audio/wav"
          ],
          "world_pattern": "*"
        }
      ],
      "cost": {
        "tier": "placeholder",
        "est_units": 0.0,
        "unit": "generation",
        "quantity": 1.0,
        "basis": "one generation",
        "unpriced": false
      },
      "endpoint": "http://127.0.0.1:8000/v1/audio/music-generations",
      "provider": "placeholder",
      "model": "placeholder-music"
    },
    {
      "name": "generate.video",
      "inputs": [
        {
          "plane": "knowledge",
          "shape": "prompt-text"
        }
      ],
      "outputs": [
        {
          "plane": "media",
          "media_types": [
            "video/mp4"
          ],
          "world_pattern": "*"
        }
      ],
      "cost": {
        "tier": "placeholder",
        "est_units": 0.0,
        "unit": "second",
        "quantity": 5.0,
        "basis": "5 seconds of video",
        "unpriced": false
      },
      "endpoint": "http://127.0.0.1:8000/v1/video/generations",
      "provider": "placeholder",
      "model": "placeholder-video"
    }
  ],
  "auth": {
    "scheme": "capability-token",
    "grants_required": [
      "invoke:generate.text",
      "invoke:generate.image",
      "invoke:generate.speech",
      "invoke:generate.music",
      "invoke:generate.video"
    ],
    "budget_units": {
      "supported": true,
      "currency": "budget_units",
      "request_key": "budget_units",
      "header": "X-Agora-Budget-Units"
    }
  }
}
